{
  "name": "secretmessagesharingwebapp",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "node aspnetcore-https",
    "start": "run-script-os",
    "start:windows": "set ASPNETCORE_URLS=\"https://localhost:7275;https://localhost:5275\" && ng serve --port 44490 --ssl --ssl-cert %APPDATA%\\ASP.NET\\https\\%npm_package_name%.pem --ssl-key %APPDATA%\\ASP.NET\\https\\%npm_package_name%.key",
    "start:default": "ng serve --port 44490 --ssl --ssl-cert $HOME/.aspnet/https/${npm_package_name}.pem --ssl-key $HOME/.aspnet/https/${npm_package_name}.key",
    "build": "ng build",
    "build:ssr": "ng run SecretMessageSharingWebApp:server:dev",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.1.3",
    "@angular/cdk": "^21.1.3",
    "@angular/common": "^21.1.3",
    "@angular/compiler": "^21.1.3",
    "@angular/core": "^21.1.3",
    "@angular/forms": "^21.1.3",
    "@angular/localize": "^21.1.3",
    "@angular/platform-browser": "^21.1.3",
    "@angular/platform-browser-dynamic": "^21.1.3",
    "@angular/platform-server": "^21.1.3",
    "@angular/router": "^21.1.3",
    "@microsoft/applicationinsights-angularplugin-js": "^15.3.8",
    "@microsoft/applicationinsights-web": "^3.3.11",
    "@microsoft/signalr": "^10.0.0",
    "@ng-bootstrap/ng-bootstrap": "^20.0.0",
    "@popperjs/core": "^2.11.8",
    "@types/file-saver": "^2.0.7",
    "@types/sjcl": "^1.0.34",
    "@uiowa/digit-only": "^4.1.0",
    "autoprefixer": "^10.4.24",
    "bootstrap": "^5.3.8",
    "eventsource": "^4.1.0",
    "file-saver": "^2.0.5",
    "jquery": "^4.0.0",
    "ngx-toastr": "^20.0.5",
    "oidc-client": "^1.11.5",
    "popper.js": "^1.16.0",
    "qrcode": "^1.5.4",
    "run-script-os": "^1.1.6",
    "rxjs": "~7.8.2",
    "sjcl": "^1.0.8",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.1.3",
    "@angular/cli": "^21.1.3",
    "@angular/compiler-cli": "^21.1.3",
    "@types/jasmine": "^6.0.0",
    "@types/node": "^22.13.1",
    "@types/qrcode": "^1.5.5",
    "jasmine-core": "~6.0.1",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "typescript": "~5.9.3"
  }
}
